for k=0, 9 {
	syn[k] = new Exp2Syn(.5)
	syn[k].tau1 = 1
	syn[k].tau2 = 5
	syn[k].e = 0
	nc[k] = new NetCon(vs[k], syn[k], 0, 0, 10e-3)
	nmda[k]= new nmdanet(.5)
	ncnmda[k] = new NetCon(vs[k],nmda[k],0,0, 10*0.0035)
}
