
// based on initxstimu.hoc
// extracellular stimulation
load_file("nrngui.hoc")

load_file("cellspec_c62564.hoc") // specifies anatomical and biophysical properties

load_file("biophys.hoc")
cvode_active(1)

forall {
  insert extracellular
  insert xtrau
}

load_file("interpxyzu.hoc")	// only interpolates sections that have xtrau

load_file("setpointersu.hoc")	// automatically calls grindaway() in interpxyzu.hoc
load_file("calcrxcu.hoc")	// computes transfer r between segments and recording electrodes
load_file("calcd.hoc")	// computes scale factor used to calculate extracellular potential
			//   produced by a uniform electrical field

load_file("zapstimu2.hoc")		// extracellular stimulus


proc init() {
	t = 0
	forall {
		v = Vrest
		if(ismembrane("nax") || ismembrane("na3")) {
			ena=55
		}
		if(ismembrane("kdr") || ismembrane("kap") || ismembrane("kad")) {
			ek=-90
		}
		if(ismembrane("hd")) {
			ehd_hd=-30
		}
	}
	finitialize(Vrest)
	fcurrent()
	forall {
		for(x) {
			if(ismembrane("na3") || ismembrane("nax")) {
				e_pas(x)=v(x)+(ina(x)+ik(x))/g_pas(x)
			}
			if(ismembrane("hd")) {
				e_pas(x)=e_pas(x)+i_hd(x)/g_pas(x)
			}
		}
	}
}


tstop = 110
setstim(0, tstop, 50, 50, 0,180)

objref vec, vecrms, apc, f
f = new File()
vec = new Vector()
soma {
	vec.record(&v(.5))
	apc = new APCount(.5)
	apc.thresh = -30
}
vecrms = new Vector()


proc sim() {
			for(amp=100; amp<= 100; amp += 100) {
			setstim(10, 100, 50, 50, amp, 180)
			run()
			apc.n = 0
		}
}



load_file("audizione.ses")
PlotShape[0].exec_menu("Shape Plot")
PlotShape[0].exec_menu("Show Diam")


ph=0
xpanel("ef slider")
xlabel("                                 ")
xslider(&ph,0,360,"changefield(100,ph,90)")
xpanel()
