objref fneu1, fneu2, fout, vneu1, vneu2, vsumvar

maxcovar = 2000
maxvar0 = 0
maxvar1 = 0
maxamp = 0
maxperc = 0

vsumvar = new Vector()
vneu1 = new Vector()
vneu2 = new Vector()
fneu1 = new File("c62564spikes.dat")
fneu2 = new File("5038804spikes.dat")
fout = new File("statistics.txt")

fneu1.ropen()
fneu2.ropen()
fout.wopen()


amp = 0
perc = 0
theta = 0
phi = 0
nspikes = 0

strdef st
for j = 0, 34 {
	for i = 0, 15 {
		fneu1.gets(st)
		sscanf(st, "%g %g %g %g %g", &amp, &perc, &theta, &phi, &nspikes)
		vneu1.append(nspikes)


		fneu2.gets(st)
		sscanf(st, "%g %g %g %g %g", &amp, &perc, &theta, &phi, &nspikes)
		vneu2.append(nspikes)
	}
	vsumvar.copy(vneu1)
	vsumvar.add(vneu2)
	covar =  (vsumvar.var() - vneu1.var() - vneu2.var()) / 2
	fout.printf("%g\t%g\t%g\t%g\t%g\r\n", amp, perc, covar, vneu1.var(), vneu2.var())
	if(covar <= maxcovar) if(maxvar0 <= vneu1.var() && maxvar1 <= vneu2.var()) {
		maxcovar = covar
		maxamp = amp
		maxperc = perc
		maxvar0 = vneu1.var()
		maxvar1 = vneu2.var()
	}
	vneu1.resize(0)
	vneu2.resize(0)
	vsumvar.resize(0)
}
print "amp=", maxamp, " perc=", maxperc, "var c62564=", maxvar0, "var 5038804=", maxvar1
fneu1.close()
fneu2.close()
fout.close()