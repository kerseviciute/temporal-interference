access soma
distance()


objref s,vecapic,vecbasal
vecapic=new Vector()
vecbasal=new Vector()
mean = 0
n = 0

mean2=0
n2=0
forsec "user5" {
	s = new SectionRef()
	if(s.nchild == 0) {
		vecapic.append(distance(1))
	}
}
forsec "apical" {
	s = new SectionRef()
	if(s.nchild == 0) {
		vecapic.append(distance(1))
	}
}

for i=0,numbasal-1 dendrite[i] {
	s = new SectionRef()
	if(s.nchild==0) {
		vecbasal.append(distance(1))
	}
}