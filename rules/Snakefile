        voltage = "output/{project}/poisson_theta_no_ltp/{idx}/{carrier}/{phi}_{psi}_{offset}/voltage.csv",
        # synapse_weights = "output/{project}/poisson_theta_no_ltp/{idx}/{carrier}/{phi}_{psi}_{offset}/synapse_weights.csv",
