        synapse_stimuli = "output/{project}/poisson_theta_no_ltp/{idx}/{carrier}/{phi}_{psi}_{offset}/synapse_stimuli.csv"
    params:
        duration = 0.25 * 60 * 1000, # ms, 1 minute
        rate = 5, # Hz, poisson rate
