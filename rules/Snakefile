rule conductance_ltp:
    input:
        seeds = "output/{project}/seeds.csv"
    output:
        synapse_info = "output/{project}/conductance_ltp/{idx}/{conductance}/synapse_info.csv",
        spike_frequency = "output/{project}/conductance_ltp/{idx}/{conductance}/spike_frequency.csv",
        voltage = "output/{project}/conductance_ltp/{idx}/{conductance}/voltage.csv",
        synapse_weights = "output/{project}/conductance_ltp/{idx}/{conductance}/synapse_weights.csv",
        synapse_voltage = "output/{project}/conductance_ltp/{idx}/{conductance}/synapse_voltage.csv",
        synapse_stimuli = "output/{project}/conductance_ltp/{idx}/{conductance}/synapse_stimuli.csv"
    params:
        n_synapses = 10,
        initial_weight = 0.1,

        duration = 3000, # ms
        ltp_start = 1000, # ms
        ltp_duration = 1000, # ms
        ltp_frequency = 100, # Hz
        test_stim_times = [100, 2500] # ms
    conda: "neuron"
    script: "python/conductance_ltp.py"

