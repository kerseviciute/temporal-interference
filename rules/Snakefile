        voltage = "output/{project}/poisson_delay_theta/{idx}/{carrier}/{phi}_{psi}_{offset}/{delay}/voltage.csv",
        synapse_weights = "output/{project}/poisson_delay_theta/{idx}/{carrier}/{phi}_{psi}_{offset}/{delay}/synapse_weights.csv",
        synapse_voltage = "output/{project}/poisson_delay_theta/{idx}/{carrier}/{phi}_{psi}_{offset}/{delay}/synapse_voltage.csv",
        synapse_stimuli = "output/{project}/poisson_delay_theta/{idx}/{carrier}/{phi}_{psi}_{offset}/{delay}/synapse_stimuli.csv"
    params:
        duration = 1 * 60 * 1000, # ms, 1 minute
        rate = 5, # Hz, poisson rate
        ef_strength = 0.9, # fraction of subthreshold amplitude
        burst_duration = 50,
        rate_in_burst = 100, # firing frequency during bursting interval
        rate_outside_burst = 1 # firing frequency outside bursting interval
    conda: "neuron"
    script: "python/poisson_in_frequency_delay.py"

