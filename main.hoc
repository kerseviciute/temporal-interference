load_file("nrngui.hoc")

// Anatomical and biophysical properties:
load_file("cellspec_c62564.hoc")
load_file("biophys.hoc")
load_file("fluct.hoc")

forall {
  insert extracellular
  insert xtrau
}

// Only interpolates sections that have xtrau
load_file("interpxyzu.hoc")

// Automatically calls grindaway() in interpxyzu.hoc
load_file("setpointersu.hoc")

// Computes transfer r between segments and recording electrodes
load_file("calcrxcu.hoc")

// Computes scale factor used to calculate extracellular potential
// produced by a uniform electrical field
load_file("calcd.hoc")

// Extracellular stimulus
load_file("zapstimu2.hoc")

load_file("burst_cell3.hoc")

proc init() {
	t = 0
	forall {
		v = Vrest
		
    if(ismembrane("nax") || ismembrane("na3")) {
			ena = 55
		}

		if(ismembrane("kdr") || ismembrane("kap") || ismembrane("kad")) {
			ek = -90
		}

		if(ismembrane("hd")) {
			ehd_h = -30
		}
	}

	finitialize(Vrest)
	fcurrent()

	forall {
		for(x) {
			if(ismembrane("na3") || ismembrane("nax")) {
				e_pas(x) = v(x) + (ina(x) + ik(x)) / g_pas(x)
			}

			if(ismembrane("hd")) {
				e_pas(x) = e_pas(x) + i_hd(x) / g_pas(x)
			}
		}
	}
}

// Adding a single synapse
objref synapse
dendrite[1] synapse = new MyExp2Syn(0.2)
synapse.tau1 = 0.5
synapse.tau2 = 1
synapse.e = 0 // mV

// Initialize a spike source for the synapse
objref spikeSource
spikeSource = new BurstCell3()

// Initialize stimulus
objref stimulus
stimulus = spikeSource.stim
stimulus.number = 4
stimulus.interval = 25  // ms
stimulus.noise = 0
stimulus.burstlen = 100  // ms
stimulus.burstint = 250 - stimulus.burstlen // ms

// Connect the synapse to the stimulus
objref connection
connection = new NetCon(stimulus, synapse)
connection.delay = 50
connection.weight = 0.0004

// Initial stimulation parameters
// (DEL, DUR, F0, F1, AMP, PHASE)
// Set stimulation end time
tstop = 1005
setstim(100, tstop, 1000, 1005, 100, 0)

objref vec, vecrms, apc, f
f = new File()
vec = new Vector()
soma {
	vec.record(&v(.5))
	apc = new APCount(.5)
	apc.thresh = -30
}

vecrms = new Vector()

// Executed on "Run" press
proc sim() {
  run()
}

load_file("audizione.ses")
PlotShape[0].exec_menu("Shape Plot")
PlotShape[0].exec_menu("Show Diam")

ph = 0
xpanel("ef slider")
xlabel("                                      ")
xslider(&ph, 0, 360, "changefield(100, ph, 90)")
xpanel()
