/*
    Adding AMPA and NMDA synapses (at the same location).
    Distribution is random but reproducible.
*/

connection_weight = 0.00009

/* Initialize parameters */

n_synapses = 10

min_distance = 100 // Minimum distance from the soma is 100 um
max_distance = 300 // Maximum distance from the soma is 300 um

/*
    Initialize the arrays for synapses and their connections
*/
objref syn_ampa[n_synapses]
objref syn_nmda[n_synapses]

objref spikeSources[n_synapses]
objref stimuli[n_synapses]

objref connections_ampa[n_synapses]
objref connections_nmda[n_synapses]

double synapse_dendrites[n_synapses]
double synapse_locations[n_synapses]
double synapse_delays[n_synapses]
double synapse_distances[n_synapses]

stim_start = 1000 // ms
stim_length = 1000 // ms

/*
    Count the number of apical dendrites
*/
n_apical_dendrites = 0
forsec "apical_dendrite" {
    n_apical_dendrites += 1
}

/*
    Initialize a random number generator (with a uniform
    distribution) for picking a random apical dendrite
*/
objref random_apical_gen
random_apical_gen = new Random()
random_apical_gen.MCellRan4(random_seed)
random_apical_gen.uniform(0, n_apical_dendrites)

/*
    Initialize a random number generator for picking the
    location within a section
*/
objref random_pos
random_pos = new Random()
random_pos.MCellRan4(random_seed)
random_pos.uniform(0, 1)

for i = 0, n_synapses - 1 {
    print "Inserting synapse ", i + 1

    // Keep choosing a random apical dendrite and a position
    // along the apical dendrite until the distance to the
    // soma is less than 300 um and more than 100 um
    distance_to_soma = max_distance + 1
    while(distance_to_soma > max_distance || distance_to_soma < min_distance) {
        dendrite_idx = int(random_apical_gen.repick())
        loc_pos = random_pos.repick()

        access apical_dendrite[dendrite_idx]
        distance_to_soma = distance(loc_pos)
    }

    print "Randomly selected apical dendrite: ", dendrite_idx
    print "Randomly selected location: ", loc_pos
    print "Randomly determined distance to soma: ", distance_to_soma

    // Initialize the synapses
    apical_dendrite[dendrite_idx] syn_ampa[i] = new STDPE2bis(loc_pos)
    apical_dendrite[dendrite_idx] syn_nmda[i] = new nmdanet(loc_pos)

    // Initialize the spike source
    spikeSources[i] = new NetStim()

    // Initialize the stimulus
    stimuli[i] = spikeSources[i]
    stimuli[i].interval = 20  // 20 ms = 50 Hz
    stimuli[i].noise = 0
    stimuli[i].number = stim_length / stimuli[i].interval
    stimuli[i].start = stim_start

    // Connect the synapses to the stimuli
    connections_ampa[i] = new NetCon(stimuli[i], syn_ampa[i])
    connections_ampa[i].delay = 0
    connections_ampa[i].weight = connection_weight

    connections_nmda[i] = new NetCon(stimuli[i], syn_nmda[i])
    connections_nmda[i].delay = 0
    connections_nmda[i].weight = connection_weight

    print "The synapse will receive input at ", connections_ampa[i].delay, "ms"
    print ""

    // Save synapse information
    synapse_dendrites[i] = dendrite_idx
    synapse_locations[i] = loc_pos
    synapse_delays[i] = connections_ampa[i].delay
    synapse_distances[i] = distance_to_soma
}
